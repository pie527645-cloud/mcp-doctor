{
  "name": "@pie527645-cloud/mcp-doctor",
  "version": "1.0.0",
  "description": "Security, prompt-injection, tool-poisoning, configuration, and context-token-tax auditor for Model Context Protocol (MCP) servers.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pie527645-cloud/mcp-doctor.git"
  },
  "homepage": "https://github.com/pie527645-cloud/mcp-doctor#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "mcp-doctor": "./dist/cli.js"
  },
  "main": "./dist/index.js",
